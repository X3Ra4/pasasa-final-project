# Copy values into /etc/pasasa/.env (root-owned, mode 640).
# systemd EnvironmentFile syntax; no export, no shell expansion.
DJANGO_SETTINGS_MODULE=PASASA.settings_cloud
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
DJANGO_ALLOWED_HOSTS=your-ec2-public-dns,127.0.0.1,localhost
# Bootstrap sets 0 for the initial HTTP smoke test. Set 1 after TLS is configured.
DJANGO_HTTPS=0
DJANGO_CSRF_TRUSTED_ORIGINS=http://your-ec2-public-dns
POSTGRES_DB=pasasa
POSTGRES_USER=pasasa
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_STATIC_ROOT=/var/lib/pasasa/static
DJANGO_MEDIA_ROOT=/var/lib/pasasa/media
